               lv2:minimum 0.0 ; lv2:maximum 2.0 ; lv2:default 0.5 ; pg:group <urn:audacity:tracktion-test:group> ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 3 ; lv2:symbol "frequency" ; lv2:name "Frequency" ;
      lv2:minimum 20.0 ; lv2:maximum 20000.0 ; lv2:default 440.0 ; lv2:portProperty props:logarithmic ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "toggle" ; lv2:name "Toggle" ;
      lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:default 1.0 ; lv2:portProperty lv2:toggled ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 5 ; lv2:symbol "mode" ; lv2:name "Mode" ;
      lv2:minimum 1.0 ; lv2:maximum 4.0 ; lv2:default 1.0 ; lv2:portProperty lv2:enumeration, lv2:integer ;
      lv2:scalePoint [ rdfs:label "Low" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1.0 ],
                     [ rdfs:label "Élevé" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 4.0 ] ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 6 ; lv2:symbol "trigger" ; lv2:name "Trigger" ;
      lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:default 0.0 ; lv2:portProperty props:trigger ],
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 7 ; lv2:symbol "meter" ; lv2:name "Meter" ;
      lv2:minimum 0.0 ; lv2:maximum 2.0 ; lv2:default 0.0 ],
    [ a atom:AtomPort, lv2:InputPort ; lv2:index 8 ; lv2:symbol "events_in" ; lv2:name "Events In" ; atom:bufferType atom:Sequence ],
    [ a atom:AtomPort, lv2:OutputPort ; lv2:index 9 ; lv2:symbol "events_out" ; lv2:name "Events Out" ; atom:bufferType atom:Sequence ] ;
    lv2:extensionData state:interface ;
    ui:ui <urn:audacity:tracktion-test:ui-echo#qt>, <urn:audacity:tracktion-test:ui-echo#x11>,
          <urn:audacity:tracktion-test:ui-echo#external> .

<urn:audacity:tracktion-test:ui-echo#qt> a ui:Qt6UI ; ui:binary <hosttest@CMAKE_SHARED_MODULE_SUFFIX@> ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/instance-access> .
<urn:audacity:tracktion-test:ui-echo#x11> a ui:X11UI ; ui:binary <hosttest@CMAKE_SHARED_MODULE_SUFFIX@> .
<urn:audacity:tracktion-test:ui-echo#external> a <http://kxstudio.sf.net/ns/lv2ext/external-ui#Widget> ; ui:binary <hosttest@CMAKE_SHARED_MODULE_SUFFIX@> .

