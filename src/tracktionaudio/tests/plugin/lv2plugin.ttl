<urn:audacity:tracktion-test:private> a lv2:AmplifierPlugin ;
    doap:name "Tracktion LV2 Private State" ; doap:maintainer [ foaf:name "Audacity" ] ;
    lv2:extensionData state:interface ;
    lv2:port [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Input" ],
             [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Output" ],
             [ a lv2:ControlPort, lv2:InputPort ; lv2:index 2 ; lv2:symbol "gain" ; lv2:name "Gain" ;
               lv2:minimum 0.0 ; lv2:maximum 2.0 ; lv2:default 0.5 ] .

<urn:audacity:tracktion-test:private#quiet> a pset:Preset ;
    lv2:appliesTo <urn:audacity:tracktion-test:private> ; rdfs:label "Quiet" ;
    lv2:port [ lv2:symbol "gain" ; pset:value 1.5 ] ;
    state:state [ <urn:audacity:privateGain> "0.25"^^xsd:float ] .

<urn:audacity:tracktion-test:private#unlabelled> a pset:Preset ;
    lv2:appliesTo <urn:audacity:tracktion-test:private> ;
    lv2:port [ lv2:symbol "gain" ; pset:value 1.0 ] ;
    state:state [ <urn:audacity:privateGain> "0.75"^^xsd:float ] .

<urn:audacity:tracktion-test:group> rdfs:label "Advanced Étage" .
<urn:audacity:tracktion-test:rich> a lv2:AmplifierPlugin ;
    doap:name "Tracktion LV2 Rich Controls" ; doap:maintainer [ foaf:name "Audacity" ] ;
    lv2:port [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Input" ],
             [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Output" ],
             [ a lv2:ControlPort, lv2:InputPort ; lv2:index 2 ; lv2:symbol "gain" ; lv2:name "Gain" ;
               lv2:minimum 0.0 ; lv2:maximum 2.0 ; lv2:default 0.5 ; pg:group <urn:audacity:tracktion-test:group> ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 3 ; lv2:symbol "frequency" ; lv2:name "Frequency" ;
      lv2:minimum 20.0 ; lv2:maximum 20000.0 ; lv2:default 440.0 ; lv2:portProperty props:logarithmic ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "toggle" ; lv2:name "Toggle" ;
      lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:default 1.0 ; lv2:portProperty lv2:toggled ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 5 ; lv2:symbol "mode" ; lv2:name "Mode" ;
      lv2:minimum 1.0 ; lv2:maximum 4.0 ; lv2:default 1.0 ; lv2:portProperty lv2:enumeration, lv2:integer ;
      lv2:scalePoint [ rdfs:label "Low" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1.0 ],
                     [ rdfs:label "Élevé" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 4.0 ] ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 6 ; lv2:symbol "trigger" ; lv2:name "Trigger" ;
      lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:default 0.0 ; lv2:portProperty props:trigger ],
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 7 ; lv2:symbol "meter" ; lv2:name "Meter" ;
      lv2:minimum 0.0 ; lv2:maximum 2.0 ; lv2:default 0.0 ] .

<urn:audacity:tracktion-test:private#bad> a pset:Preset ;
    lv2:appliesTo <urn:audacity:tracktion-test:private> ; rdfs:label "Bad" ;
    lv2:port [ lv2:symbol "gain" ; pset:value 0.0 ] ;
    state:state [ <urn:audacity:privateGain> "invalid" ] .

<urn:audacity:tracktion-test:private#partial> a pset:Preset ;
    lv2:appliesTo <urn:audacity:tracktion-test:private> ; rdfs:label "Partial" ;
    state:state [ <urn:audacity:privateGain> "0.5"^^xsd:float ] .

<urn:audacity:tracktion-test:duplicates> a lv2:AmplifierPlugin ;
    doap:name "Tracktion LV2 Duplicate Names" ; doap:maintainer [ foaf:name "Audacity" ] ;
    lv2:port [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Input" ],
             [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Output" ],
             [ a lv2:ControlPort, lv2:InputPort ; lv2:index 2 ; lv2:symbol "gain" ; lv2:name "Gain " ;
               lv2:minimum 0.0 ; lv2:maximum 2.0 ; lv2:default 0.5 ],
             [ a lv2:ControlPort, lv2:InputPort ; lv2:index 3 ; lv2:symbol "other" ; lv2:name "Gain" ;
               lv2:minimum 0.0 ; lv2:maximum 2.0 ; lv2:default 0.5 ],
             [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "state" ; lv2:name "__LV2State " ;
               lv2:minimum 0.0 ; lv2:maximum 2.0 ; lv2:default 0.5 ],
             [ a lv2:ControlPort, lv2:InputPort ; lv2:index 5 ; lv2:symbol "ports" ; lv2:name "__LV2Ports " ;
               lv2:minimum 0.0 ; lv2:maximum 2.0 ; lv2:default 0.5 ] .

<urn:audacity:tracktion-test:ui-echo> a lv2:AmplifierPlugin ;
    doap:name "Tracktion LV2 UI Echo" ; doap:maintainer [ foaf:name "Audacity" ] ;
    lv2:port [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Input" ],
             [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Output" ],
