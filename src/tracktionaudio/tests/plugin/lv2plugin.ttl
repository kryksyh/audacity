             [ a lv2:ControlPort, lv2:InputPort ; lv2:index 2 ; lv2:symbol "gain" ; lv2:name "Gain" ;
               lv2:minimum 0.0 ; lv2:maximum 0.5 ; lv2:default 0.25 ; lv2:portProperty lv2:sampleRate ] .

<urn:audacity:tracktion-test:bounded-default> a lv2:AmplifierPlugin ;
