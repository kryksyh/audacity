+QJSValue TestflowApi::widgetInfo(const QString& objectName) const
+{
+    const auto* widget = namedWidget(objectName);
+    if (!widget) return QJSValue(QJSValue::NullValue);
+    auto result = engine()->newObject();
+    result.setProperty("width", widget->width());
+    result.setProperty("height", widget->height());
+    result.setProperty("focus", widget->hasFocus());
+    result.setProperty("className", widget->metaObject()->className());
+    result.setProperty("windowTitle", widget->window()->windowTitle());
+    if (const auto text = widget->property("text"); text.isValid()) result.setProperty("text", text.toString());
+    for (const auto* property : { "value", "minimum", "maximum" }) {
+        const auto value = widget->property(property);
+        if (value.isValid()) result.setProperty(property, value.toInt());
+    }
+    return result;
+}
+
+QJSValue TestflowApi::widgetButtons() const
+{
+    auto result = engine()->newArray();
+    quint32 index = 0;
+    if (!qobject_cast<QApplication*>(QCoreApplication::instance())) return result;
+    for (const auto* widget : QApplication::allWidgets()) {
+        const auto* button = qobject_cast<const QAbstractButton*>(widget);
+        if (!button || !button->isVisible()) continue;
+        auto entry = engine()->newObject();
+        entry.setProperty("text", button->text().remove('&'));
+        entry.setProperty("enabled", button->isEnabled());
+        entry.setProperty("windowTitle", button->window()->windowTitle());
+        result.setProperty(index++, entry);
+    }
+    return result;
+}
