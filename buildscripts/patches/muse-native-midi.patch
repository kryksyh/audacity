+bool NavigationApi::triggerAccessibleControl(const QString& name, bool activePanelOnly)
+{
+    if (name.isEmpty()) return false;
+    INavigationControl* found = nullptr;
+    for (auto* section : navigation()->sections()) {
+        if (!section->enabled()) continue;
+        for (auto* panel : section->panels()) {
+            if (activePanelOnly && panel != navigation()->activePanel()) continue;
+            if (!panel->enabled()) continue;
+            for (auto* control : panel->controls()) {
+                if (!control->enabled() || !control->window() || !control->window()->isVisible()
+                    || !control->visualItem() || !control->visualItem()->isVisible() || accessibleLabel(control) != name) continue;
+                if (found) return false;
+                found = control;
+            }
+        }
+    }
+    if (!found) return false;
+    found->requestActive();
+    trigger();
+    return true;
+}
