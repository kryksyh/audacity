+    if (!item || !item->isVisible() || !item->isEnabled()) return;
+    if (item->objectName() == name) found.push_back(item);
+    for (auto* child : item->childItems()) findVisibleItems(child, name, found);
+}
+
+QQuickItem* namedWindowItem(const QString& name)
+{
+    QList<QQuickItem*> found;
+    if (name.isEmpty()) return nullptr;
+    for (auto* window : QGuiApplication::topLevelWindows()) {
+        if (auto* quick = qobject_cast<QQuickWindow*>(window); quick && quick->isVisible()) {
+            findVisibleItems(quick->contentItem(), name, found);
+        }
+    }
+    return found.size() == 1 ? found.front() : nullptr;
+}
+
+QWidget* namedWidget(const QString& name)
+{
+    if (name.isEmpty() || !qobject_cast<QApplication*>(QCoreApplication::instance())) return nullptr;
+    QWidget* result = nullptr;
+    for (auto* widget : QApplication::allWidgets()) {
+        if (widget->objectName() != name || !widget->isVisible() || !widget->isEnabled()) continue;
+        if (result) return nullptr;
+        result = widget;
+    }
+    return result;
+}
+
