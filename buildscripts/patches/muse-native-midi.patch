+QJSValue TestflowApi::itemWindowInfo(const QString& objectName) const
+{
+    const auto* item = namedWindowItem(objectName);
+    if (!item || !item->window()) return QJSValue(QJSValue::NullValue);
+    const auto* window = item->window();
+    auto result = engine()->newObject();
+    result.setProperty("title", window->title());
+    result.setProperty("mainWindow", window == mainWindow()->qWindow());
+    result.setProperty("parentIsMain", window->transientParent() == mainWindow()->qWindow());
+    result.setProperty("modal", window->modality() != Qt::NonModal);
+    result.setProperty("width", window->width());
+    result.setProperty("height", window->height());
+    result.setProperty("activeFocus", item->hasActiveFocus());
+    result.setProperty("windowActive", window->isActive());
+    result.setProperty("focusWindow", QGuiApplication::focusWindow() == window);
+    const auto* focusItem = window->activeFocusItem();
+    result.setProperty("focusItem", focusItem ? focusItem->objectName() : QString());
+    const auto value = item->property("currentValue");
+    if (value.isValid()) result.setProperty("currentValue", value.toDouble());
+    const auto text = item->property("currentText");
+    if (text.isValid()) result.setProperty("currentText", text.toString());
+    const auto label = item->property("text");
+    if (label.isValid()) result.setProperty("text", label.toString());
+    for (const auto* property : { "contentX", "contentY", "contentWidth", "contentHeight" }) {
+        const auto metric = item->property(property);
+        if (metric.isValid()) result.setProperty(property, metric.toDouble());
+    }
+    const auto available = item->property("available");
+    if (available.isValid()) result.setProperty("available", available.toBool());
+    return result;
+}
+
+bool TestflowApi::closeItemWindow(const QString& objectName)
+{
+    const auto* item = namedWindowItem(objectName);
+    auto* window = item ? item->window() : nullptr;
+    return window && window != mainWindow()->qWindow() && window->close();
+}
