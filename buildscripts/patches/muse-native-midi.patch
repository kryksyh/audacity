+bool TestflowApi::mouseClickWidget(const QString& objectName, double x, double y)
+{
+    if (!std::isfinite(x) || !std::isfinite(y) || x < 0.0 || x > 1.0 || y < 0.0 || y > 1.0) return false;
+    auto* widget = namedWidget(objectName);
+    if (!widget || widget->width() <= 0 || widget->height() <= 0) return false;
+    const QPoint point(qRound(x * (widget->width() - 1)), qRound(y * (widget->height() - 1)));
+    QTest::mouseClick(widget, Qt::LeftButton, Qt::NoModifier, point);
+    return true;
+}
+
+bool TestflowApi::mouseDragWidget(const QString& objectName, double fromX, double fromY, double toX, double toY)
+{
+    if (!std::isfinite(fromX) || !std::isfinite(fromY) || !std::isfinite(toX) || !std::isfinite(toY)) return false;
+    auto* widget = namedWidget(objectName);
+    if (!widget || widget->width() <= 0 || widget->height() <= 0) return false;
+    const auto point = [widget](double x, double y) {
+        return QPointF(x * (widget->width() - 1), y * (widget->height() - 1));
+    };
+    const auto from = point(fromX, fromY);
+    const auto to = point(toX, toY);
+    QPointer<QWidget> guard(widget);
+    QTest::mouseMove(widget, from.toPoint());
+    QTest::mousePress(widget, Qt::LeftButton, Qt::NoModifier, from.toPoint());
+    for (int i = 1; i <= 12; ++i) {
+        if (!guard) return false;
+        QTest::mouseMove(widget, (from + (to - from) * (i / 12.0)).toPoint(), 10);
+        sleep(10);
+    }
+    if (!guard) return false;
+    QTest::mouseRelease(widget, Qt::LeftButton, Qt::NoModifier, to.toPoint());
+    return true;
+}
+
+bool TestflowApi::mouseClickItem(const QString& objectName, double x, double y, const QString& button, bool doubleClick)
+{
+    if (!std::isfinite(x) || !std::isfinite(y) || x < 0.0 || x > 1.0 || y < 0.0 || y > 1.0) return false;
+    auto* item = namedWindowItem(objectName);
+    if (!item || item->width() <= 0.0 || item->height() <= 0.0) return false;
+    auto* window = item->window();
+    if (!window) return false;
+    const auto mouseButton = button == "left" ? Qt::LeftButton : button == "right" ? Qt::RightButton
+        : button == "middle" ? Qt::MiddleButton : Qt::NoButton;
+    if (mouseButton == Qt::NoButton) return false;
+    const auto point = item->mapToScene({ x * item->width(), y * item->height() });
+    QTest::mouseMove(window, point.toPoint());
+    if (doubleClick) {
+        QTest::mouseDClick(window, mouseButton, Qt::NoModifier, point.toPoint(), 10);
+    } else QTest::mouseClick(window, mouseButton, Qt::NoModifier, point.toPoint());
+    return true;
+}
+
+bool TestflowApi::typeItemText(const QString& objectName, const QString& text, bool accept)
+{
+    QPointer<QQuickItem> item(namedWindowItem(objectName));
+    QPointer<QQuickWindow> window(item ? item->window() : nullptr);
+    if (!item || !window || !mouseClickItem(objectName)) return false;
+    const auto* focus = window->activeFocusItem();
+    // Refuse to send text unless the requested editor owns keyboard focus.
+    // Otherwise letters such as I and R would invoke timeline shortcuts.
+    if (!focus || (focus != item && !item->isAncestorOf(focus))) return false;
+    QTest::keySequence(window.data(), QKeySequence(QKeySequence::SelectAll));
+    for (const QChar ch : text) {
+        if (!item || !window) return false;
+        QKeyEvent press(QEvent::KeyPress, Qt::Key_unknown, Qt::NoModifier, QString(ch));
+        QCoreApplication::sendEvent(window.data(), &press);
+        if (!item || !window) return false;
+        QKeyEvent release(QEvent::KeyRelease, Qt::Key_unknown, Qt::NoModifier, QString(ch));
+        QCoreApplication::sendEvent(window.data(), &release);
+    }
+    if (!item || !window) return false;
+    if (accept) QTest::keyClick(window.data(), Qt::Key_Return);
+    return true;
+}
+
+bool TestflowApi::mouseDragItem(const QString& objectName, double fromX, double fromY, double toX, double toY)
+{
+    if (!std::isfinite(fromX) || !std::isfinite(fromY) || !std::isfinite(toX) || !std::isfinite(toY)) return false;
+    auto* item = namedWindowItem(objectName);
+    if (!item || item->width() <= 0.0 || item->height() <= 0.0) return false;
+    auto* window = item->window();
+    if (!window) return false;
+    const auto from = item->mapToScene({ fromX * item->width(), fromY * item->height() });
+    const auto to = item->mapToScene({ toX * item->width(), toY * item->height() });
+    QPointer<QQuickWindow> guard(window);
+    QTest::mouseMove(window, from.toPoint());
+    QTest::mousePress(window, Qt::LeftButton, Qt::NoModifier, from.toPoint());
+    for (int i = 1; i <= 12; ++i) {
+        if (!guard) return false;
+        QTest::mouseMove(window, (from + (to - from) * (i / 12.0)).toPoint(), 10);
+        sleep(10);
+    }
+    if (!guard) return false;
+    QTest::mouseRelease(window, Qt::LeftButton, Qt::NoModifier, to.toPoint());
+    return true;
+}
+
+bool TestflowApi::mouseClickControl(const QString& section, const QString& panel, const QString& name)
+{
+    const auto* control = navigation()->findControl(section.toStdString(), panel.toStdString(), name.toStdString());
+    auto* item = control && control->enabled() ? control->visualItem() : nullptr;
+    auto* window = item ? item->window() : nullptr;
+    if (!window || !item->isVisible() || !item->isEnabled() || item->width() <= 0.0 || item->height() <= 0.0) return false;
+    const auto point = item->mapToScene(item->boundingRect().center()).toPoint();
+    QTest::mouseClick(window, Qt::LeftButton, Qt::NoModifier, point);
+    return true;
+}
+
+bool TestflowApi::typeControlText(const QString& section, const QString& panel, const QString& name, const QString& text)
+{
+    const auto* control = navigation()->findControl(section.toStdString(), panel.toStdString(), name.toStdString());
+    QPointer<QQuickItem> item(control && control->enabled() ? control->visualItem() : nullptr);
+    QPointer<QQuickWindow> window(item ? item->window() : nullptr);
+    if (!item || !window || !item->isVisible() || !item->isEnabled()) return false;
+    if (!mouseClickControl(section, panel, name) || !item || !window) return false;
+    const auto* focus = window->activeFocusItem();
+    if (!focus || (focus != item && !item->isAncestorOf(focus))) return false;
+    // Target the clicked field's window, as in typeWidgetText. OS focus can
+    // remain elsewhere when a test sends a synthetic click to a popup.
+    QTest::keySequence(window.data(), QKeySequence(QKeySequence::SelectAll));
+    for (const QChar ch : text) {
+        if (!item || !window) return false;
+        QKeyEvent press(QEvent::KeyPress, Qt::Key_unknown, Qt::NoModifier, QString(ch));
+        QCoreApplication::sendEvent(window.data(), &press);
+        if (!item || !window) return false;
+        QKeyEvent release(QEvent::KeyRelease, Qt::Key_unknown, Qt::NoModifier, QString(ch));
+        QCoreApplication::sendEvent(window.data(), &release);
+    }
+    return item && window;
+}
