diff --git a/framework/interactive/tests/interactiveclose_tests.cpp b/framework/interactive/tests/interactiveclose_tests.cpp
new file mode 100644
index 000000000..482bdb33e
--- /dev/null
+++ b/framework/interactive/tests/interactiveclose_tests.cpp
@@ -0,0 +1,139 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include <gtest/gtest.h>
+
+#include <QEventLoop>
+#include <QWindow>
+
+#include "async/async.h"
+#include "async/processevents.h"
+#include "interactive/internal/interactive.h"
+#include "interactive/internal/interactiveuriregister.h"
+
+using namespace muse;
+using namespace muse::interactive;
+
+class Interactive_CloseTests : public ::testing::Test
+{
+protected:
+    void SetUp() override
+    {
+        registry = std::make_shared<InteractiveUriRegister>();
+        modularity::globalIoc()->registerExport<IInteractiveUriRegister>("close-tests", registry);
+        interactive = std::make_unique<Interactive>(nullptr);
+        interactive->openRequested().onReceive(&receiver, [this](QmlLaunchData* data) {
+            const QString id = QString::number(++nextId);
+            data->setValue("objectId", id);
+            data->setValue("ret", QVariantMap { { "errcode", 0 } });
+            interactive->onOpen(ContainerMeta::QmlDialog, id, &window);
+        });
+        interactive->closeRequested().onReceive(&receiver, [this](const QVariant& id) {
+            ++closeRequests;
+            interactive->onClose(id.toString(), QVariantMap { { "errcode", 0 } });
+        });
+    }
+
+    void TearDown() override
+    {
+        // Drain open notifications while their provider and receiver still live.
+        async::processMessages();
+        interactive.reset();
+        modularity::globalIoc()->unregister<IInteractiveUriRegister>("close-tests");
+    }
+
+    UriQuery openDialog(const std::string& path)
+    {
+        Uri uri("muse://close-tests/" + path);
+        registry->registerQmlUri(uri, "UnusedTestDialog.qml");
+        UriQuery query(uri);
+        auto opened = interactive->open(query);
+        opened.onResolve(&receiver, [](const Val&) {});
+        opened.onReject(&receiver, [](int, const std::string&) { ADD_FAILURE() << "Fake dialog did not open"; });
+        EXPECT_TRUE(interactive->isOpened(query).val);
+        return query;
+    }
+
+    // Commands are delivered from this queue in the app. A synchronous dialog
+    // close must finish without recursively draining the queue already in use.
+    template<typename F> void fromCommandQueue(F action)
+    {
+        bool completed = false;
+        QEventLoop loop;
+        async::Async::call(&receiver, [&] {
+            action();
+            completed = true;
+            loop.quit();
+        });
+        // Let the real single-shot ticker deliver the queued command, just as
+        // in the app. Manually draining it while that timer is active would
+        // introduce a second, artificial recursive queue drain during a wait.
+        loop.exec();
+        EXPECT_TRUE(completed);
+    }
+
+    std::shared_ptr<InteractiveUriRegister> registry;
+    std::unique_ptr<Interactive> interactive;
+    async::Asyncable receiver;
+    QWindow window;
+    int nextId = 0;
+    int closeRequests = 0;
+};
+
+TEST_F(Interactive_CloseTests, CloseAllFromCommandQueueWaitsForEveryDialog)
+{
+    auto first = openDialog("first");
+    auto second = openDialog("second");
+    fromCommandQueue([&] {
+        EXPECT_TRUE(interactive->closeAllDialogsSync());
+        EXPECT_EQ(closeRequests, 2);
+        EXPECT_FALSE(interactive->isOpened(first).val);
+        EXPECT_FALSE(interactive->isOpened(second).val);
+    });
+}
+
+TEST_F(Interactive_CloseTests, CloseOneFromCommandQueueKeepsOtherDialog)
+{
+    auto first = openDialog("first");
+    auto second = openDialog("second");
+    fromCommandQueue([&] {
+        EXPECT_TRUE(interactive->closeSync(first));
+        EXPECT_EQ(closeRequests, 1);
+        EXPECT_FALSE(interactive->isOpened(first).val);
+        EXPECT_TRUE(interactive->isOpened(second).val);
+        EXPECT_TRUE(interactive->closeAllDialogsSync());
+    });
+}
+
+TEST_F(Interactive_CloseTests, ImmediateCloseFailureReturnsWithoutEnteringWait)
+{
+    auto query = openDialog("missing-widget");
+    // Simulate a registered QWidget dialog whose native window disappeared.
+    registry->unregisterUri(query.uri());
+    registry->registerUri(query.uri(), ContainerMeta(ContainerMeta::QWidgetDialog));
+    fromCommandQueue([&] {
+        EXPECT_FALSE(interactive->closeSync(query));
+        EXPECT_TRUE(interactive->isOpened(query).val);
+    });
+    registry->unregisterUri(query.uri());
+    registry->registerQmlUri(query.uri(), "UnusedTestDialog.qml");
+    fromCommandQueue([&] { EXPECT_TRUE(interactive->closeAllDialogsSync()); });
+}
+
+TEST_F(Interactive_CloseTests, AsyncCloseStillNotifiesAfterAllDialogsClose)
+{
+    auto first = openDialog("first");
+    auto second = openDialog("second");
+    QEventLoop loop;
+    bool completed = false;
+    auto closing = interactive->closeAllDialogs();
+    closing.onResolve(&receiver, [&](const Ret& ret) {
+        EXPECT_TRUE(ret);
+        EXPECT_EQ(closeRequests, 2);
+        EXPECT_FALSE(interactive->isOpened(first).val);
+        EXPECT_FALSE(interactive->isOpened(second).val);
+        completed = true;
+        loop.quit();
+    });
+    EXPECT_FALSE(completed);
+    loop.exec();
+    EXPECT_TRUE(completed);
+}
