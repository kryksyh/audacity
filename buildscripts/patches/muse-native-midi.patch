+namespace {
+IMidiInPort::InputTime inputTime(MIDITimeStamp timestamp)
+{
+    using Clock = std::chrono::steady_clock;
+    const auto now = Clock::now();
+    if (timestamp == 0) return now;
+    const auto hostNow = AudioGetCurrentHostTime();
+    const bool past = timestamp < hostNow;
+    const auto nanos = AudioConvertHostTimeToNanos(past ? hostNow - timestamp : timestamp - hostNow);
+    const auto delta = std::chrono::duration<long double>(nanos * 1e-9L);
+    const auto target = std::chrono::duration<long double>(now.time_since_epoch()) + (past ? -delta : delta);
+    if (target < Clock::time_point::min().time_since_epoch() || target > Clock::time_point::max().time_since_epoch()) return now;
+    return Clock::time_point(std::chrono::duration_cast<Clock::duration>(target));
+}
