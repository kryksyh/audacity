+void TestflowApi::after(int msec, const QJSValue& func, const QJSValueList& args)
+{
+    if (msec < 0 || !func.isCallable()) {
+        fatal(QStringLiteral("after requires a nonnegative delay and a callable function"));
+        return;
+    }
+    QTimer::singleShot(msec, this, [this, func, args]() mutable {
+        if (testflow()->status() != ITestflow::Status::Running) return;
+        const auto result = func.call(args);
+        if (result.isError()) fatal(result.toString());
+    });
+}
