+    // Optional high-resolution input time, in the steady clock's epoch. Drivers
+    // capture/convert this before asynchronous delivery to the UI. Legacy tick
+    // units differ by platform and must not be interpreted as this clock.
+    using InputTime = std::chrono::steady_clock::time_point;
+    virtual std::optional<async::Channel<InputTime, Event>> timestampedEventReceived() const { return std::nullopt; }
+
+    // Optional driver-thread delivery. Implementations serialize receive/lost
+    // calls and finish any in-flight call before clearRealtimeReceiver returns.
+    // Receivers must only publish bounded data, without touching UI or plugins.
+    // lost() also runs on replacement, disconnect, and endpoint removal.
+    class RealtimeReceiver {
+    public:
+        virtual ~RealtimeReceiver() = default;
+        virtual void receive(InputTime, const Event&) noexcept = 0;
+        virtual void lost(InputTime) noexcept = 0;
+    };
+    virtual bool setRealtimeReceiver(const std::shared_ptr<RealtimeReceiver>&) { return false; }
+    // Identity-checked: an old session cannot detach a newer session's receiver.
+    virtual void clearRealtimeReceiver(const std::shared_ptr<RealtimeReceiver>&) {}
 };
 }
 
