+bool TestflowApi::mouseClickWidgetButton(const QString& text)
+{
+    if (text.isEmpty() || !qobject_cast<QApplication*>(QCoreApplication::instance())) return false;
+    QAbstractButton* found = nullptr;
+    for (auto* widget : QApplication::allWidgets()) {
+        auto* button = qobject_cast<QAbstractButton*>(widget);
+        if (!button || !button->isVisible() || !button->isEnabled() || button->text().remove('&') != text) continue;
+        if (found) return false;
+        found = button;
+    }
+    if (!found) return false;
+    QTest::mouseClick(found, Qt::LeftButton, Qt::NoModifier, found->rect().center());
+    return true;
+}
+
+bool TestflowApi::typeWidgetText(const QString& objectName, const QString& text)
+{
+    QPointer<QLineEdit> editor(qobject_cast<QLineEdit*>(namedWidget(objectName)));
+    if (!editor || editor->isReadOnly()) return false;
+    editor->window()->activateWindow();
+    QApplication::setActiveWindow(editor->window());
+    editor->setFocus(Qt::OtherFocusReason);
+    // Target the actual widget, as with the mouse helpers. A synthetic QWidget
+    // click does not activate its OS window, so focusWindow() may still point
+    // at the main Quick window. Send input events rather than setting text.
+    QTest::keySequence(editor.data(), QKeySequence(QKeySequence::SelectAll));
+    for (const QChar ch : text) {
+        if (!editor) return false;
+        QKeyEvent press(QEvent::KeyPress, Qt::Key_unknown, Qt::NoModifier, QString(ch));
+        QCoreApplication::sendEvent(editor.data(), &press);
+        if (!editor) return false;
+        QKeyEvent release(QEvent::KeyRelease, Qt::Key_unknown, Qt::NoModifier, QString(ch));
+        QCoreApplication::sendEvent(editor.data(), &release);
+    }
+    return !editor.isNull();
+}
